generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Cada Empresa es un negocio/cliente independiente dentro del mismo deploy.
// Todo dato de negocio (productos, ventas, clientes, etc.) cuelga de una
// Empresa. El aislamiento entre negocios se logra filtrando SIEMPRE por
// empresaId en cada query — no hay separación física de datos.
model Empresa {
  id        Int      @id @default(autoincrement())
  nombre    String
  activa    Boolean  @default(true)
  createdAt DateTime @default(now())

  usuarios         Usuario[]
  configuracion    Configuracion?
  marcas           Marca[]
  categorias       Categoria[]
  productos        Producto[]
  historialPrecios HistorialPrecio[]
  clientes         Cliente[]
  ventas           Venta[]
  presupuestos     Presupuesto[]
  proveedores      Proveedor[]
  compras          Compra[]
  cuentas          Cuenta[]
  movimientosCaja  MovimientoCaja[]
  cierresCaja      CierreCaja[]
  sesionesCaja     SesionCaja[]
  categoriasGasto  CategoriaGasto[]
  gastos           Gasto[]
}

// ADMIN ve todo. EMPLEADO (solo licencia PREMIUM, máximo uno por empresa)
// usa Ventas, Pedidos, Clientes y ve Productos sin costos. Los permisos
// están en src/lib/permisos.ts.
enum RolUsuario {
  ADMIN
  EMPLEADO
}

model Usuario {
  id           Int @id @default(autoincrement())
  nombre       String
  email        String            @unique
  passwordHash String
  rol          RolUsuario        @default(ADMIN)
  activo       Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  empresa   Empresa @relation(fields: [empresaId], references: [id])
  empresaId Int

  @@index([empresaId])
}

model Marca {
  id        Int @id @default(autoincrement())
  nombre    String
  activa    Boolean    @default(true)
  productos Producto[]

  empresa   Empresa @relation(fields: [empresaId], references: [id])
  empresaId Int

  @@unique([empresaId, nombre])
  @@index([empresaId])
}

model Categoria {
  id        Int @id @default(autoincrement())
  nombre    String
  activa    Boolean    @default(true)
  productos Producto[]

  empresa   Empresa @relation(fields: [empresaId], references: [id])
  empresaId Int

  @@unique([empresaId, nombre])
  @@index([empresaId])
}

enum MonedaPrecio {
  ARS
  USD
}

model Producto {
  id                Int @id @default(autoincrement())
  nombre            String
  codigoBarras      String?
  ubicacionDeposito String?
  fotoUrl           String?
  contenidoMl       Int?

  marca       Marca?     @relation(fields: [marcaId], references: [id])
  marcaId     Int?
  categoria   Categoria? @relation(fields: [categoriaId], references: [id])
  categoriaId Int?

  stockActual Int     @default(0)
  stockMinimo Int     @default(0)
  destacado   Boolean @default(false)

  // Precios — moneda configurable por producto (no todos se cargan en USD)
  monedaPrecio    MonedaPrecio @default(USD)
  precioCosto     Float
  precioVenta     Float // precio minorista
  margenMinorista Float? // % informativo, no siempre se persiste calculado
  precioMayorista Float?
  margenMayorista Float?
  precioOferta    Float?

  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empresa   Empresa @relation(fields: [empresaId], references: [id])
  empresaId Int

  itemsVenta       ItemVenta[]
  itemsCompra      ItemCompra[]
  historialPrecios HistorialPrecio[]

  @@unique([empresaId, codigoBarras])
  @@index([nombre])
  @@index([empresaId])
}

enum CampoPrecio {
  COSTO
  MINORISTA
  MAYORISTA
}

enum OrigenCambioPrecio {
  MANUAL
  ACTUALIZACION_MASIVA
  COMPRA_CONFIRMADA
}

model HistorialPrecio {
  id            Int @id @default(autoincrement())
  producto      Producto           @relation(fields: [productoId], references: [id])
  productoId    Int
  campo         CampoPrecio
  valorAnterior Float?
  valorNuevo    Float
  origen        OrigenCambioPrecio
  detalle       String?
  fecha         DateTime           @default(now())

  empresa   Empresa @relation(fields: [empresaId], references: [id])
  empresaId Int

  @@index([productoId])
  @@index([fecha])
  @@index([productoId, campo])
  @@index([empresaId])
}

model Cliente {
  id          Int @id @default(autoincrement())
  nombre      String
  apellido    String?
  telefono    String?
  email       String?
  direccion   String?
  localidad   String?
  esMayorista Boolean  @default(false)
  createdAt   DateTime @default(now())

  empresa   Empresa @relation(fields: [empresaId], references: [id])
  empresaId Int

  ventas       Venta[]
  presupuestos Presupuesto[]

  @@index([nombre])
  @@index([apellido])
  @@index([empresaId])
}

enum EstadoPago {
  PAGADA
  A_CUENTA
  ANULADA
  CANCELADA
}

enum TipoPrecioVenta {
  MINORISTA
  MAYORISTA
}

model Venta {
  id         Int @id @default(autoincrement())
  cliente   Cliente? @relation(fields: [clienteId], references: [id])
  clienteId Int?

  presupuesto   Presupuesto? @relation(fields: [presupuestoId], references: [id])
  presupuestoId Int?         @unique

  fecha           DateTime @default(now())
  cotizacionUsada Float

  descuentoMonto      Float?
  descuentoPorcentaje Float?

  totalUSD    Float
  totalARS    Float
  montoPagado Float @default(0)

  estadoPago EstadoPago @default(PAGADA)

  armado   Boolean @default(false)
  enviado  Boolean @default(false)
  retirado Boolean @default(false)
  impreso  Boolean @default(false)

  empresa   Empresa @relation(fields: [empresaId], references: [id])
  empresaId Int

  items           ItemVenta[]
  pagos           PagoVenta[]
  movimientosCaja MovimientoCaja[]

  @@index([clienteId])
  @@index([fecha])
  @@index([estadoPago])
  @@index([estadoPago, fecha])   // cubre filtro por estado + orden por fecha juntos
  @@index([retirado, estadoPago]) // la pantalla de Pedidos siempre filtra por estos dos
  @@index([armado])
  @@index([enviado])
  @@index([empresaId])
}

model ItemVenta {
  id          Int @id @default(autoincrement())
  venta   Venta  @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  ventaId Int

  // Nullable: contempla el botón "Varios / Muestra" (ítem libre sin producto de catálogo)
  producto         Producto? @relation(fields: [productoId], references: [id])
  productoId       Int?
  descripcionLibre String?

  tipoPrecio        TipoPrecioVenta @default(MINORISTA)
  cantidad          Int
  precioUnitarioUSD Float

  @@index([ventaId])
  @@index([productoId])
}

model PagoVenta {
  id       Int @id @default(autoincrement())
  venta    Venta  @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  ventaId  Int
  cuenta   Cuenta @relation(fields: [cuentaId], references: [id])
  cuentaId Int
  monto    Float    // en la moneda de la cuenta (USD si la cuenta es en dólares)
  montoARS Float?   // equivalente en ARS que se descontó de la venta (null en pagos viejos)
  fecha    DateTime @default(now())

  @@index([ventaId])
}

enum EstadoPresupuesto {
  BORRADOR
  VENCIDO
  CONVERTIDO
}

model Presupuesto {
  id        Int @id @default(autoincrement())
  cliente   Cliente? @relation(fields: [clienteId], references: [id])
  clienteId Int?

  fecha            DateTime @default(now())
  vigenciaDias     Int      @default(15)
  fechaVencimiento DateTime

  observaciones       String?
  descuentoMonto      Float?
  descuentoPorcentaje Float?
  total               Float

  estado EstadoPresupuesto @default(BORRADOR)

  empresa   Empresa @relation(fields: [empresaId], references: [id])
  empresaId Int

  items           PresupuestoItem[]
  ventaConvertida Venta?

  @@index([empresaId])
}

model PresupuestoItem {
  id          Int @id @default(autoincrement())
  presupuesto    Presupuesto     @relation(fields: [presupuestoId], references: [id], onDelete: Cascade)
  presupuestoId  Int
  productoId     Int?
  descripcion    String
  tipoPrecio     TipoPrecioVenta @default(MINORISTA)
  cantidad       Int
  precioUnitario Float

  @@index([presupuestoId])
}

model Proveedor {
  id              Int @id @default(autoincrement())
  nombre          String
  personaContacto String?
  telefono        String?
  email           String?
  deudaInicial    Float    @default(0)
  notas           String?
  createdAt       DateTime @default(now())

  empresa   Empresa @relation(fields: [empresaId], references: [id])
  empresaId Int

  compras Compra[]
  gastos  Gasto[]

  @@index([nombre])
  @@index([empresaId])
}

model Compra {
  id          Int @id @default(autoincrement())
  proveedor   Proveedor? @relation(fields: [proveedorId], references: [id])
  proveedorId Int?

  cuenta   Cuenta @relation(fields: [cuentaId], references: [id])
  cuentaId Int

  totalUSD        Float
  totalARS        Float?
  cotizacionUsada Float?

  confirmada Boolean  @default(false)
  pagada     Boolean  @default(false)
  recibida   Boolean  @default(false)
  cancelada  Boolean  @default(false)
  fecha      DateTime @default(now())

  empresa   Empresa @relation(fields: [empresaId], references: [id])
  empresaId Int

  items           ItemCompra[]
  movimientosCaja MovimientoCaja[]

  @@index([proveedorId])
  @@index([cuentaId])
  @@index([fecha])
  @@index([empresaId])
}

model ItemCompra {
  id               Int @id @default(autoincrement())
  compra           Compra   @relation(fields: [compraId], references: [id], onDelete: Cascade)
  compraId         Int
  producto         Producto @relation(fields: [productoId], references: [id])
  productoId       Int
  cantidad         Int
  costoUnitarioUSD Float

  @@index([compraId])
  @@index([productoId])
}

enum TipoCuenta {
  EFECTIVO_ARS
  EFECTIVO_USD
  BANCO_ARS
  BANCO_USD
}

model Cuenta {
  id       Int @id @default(autoincrement())
  nombre   String
  tipo     TipoCuenta
  titular  String?
  banco    String?
  alias    String?
  cbu      String?
  color    String?
  favorita Boolean    @default(false)

  saldoInicial          Float  @default(0)
  saldoActual           Float  @default(0)
  limiteMensualIngresos Float?

  activa    Boolean  @default(true)
  createdAt DateTime @default(now())

  empresa   Empresa @relation(fields: [empresaId], references: [id])
  empresaId Int

  movimientos MovimientoCaja[]
  pagosVenta  PagoVenta[]
  compras Compra[]
  cierres     CierreCajaCuenta[]

  @@index([nombre])
  @@index([empresaId])
}

enum TipoMovimientoCaja {
  INGRESO
  EGRESO
}

enum ConceptoMovimientoCaja {
  VENTA_COBRADA
  PAGO_DEUDA_CLIENTE
  PAGO_A_PROVEEDOR
  GASTO
  OTRO
  AJUSTE_SALDO      // ← nuevo
  TRANSFERENCIA     // ← nuevo
}

model MovimientoCaja {
  id              Int @id @default(autoincrement())
  cuenta          Cuenta                 @relation(fields: [cuentaId], references: [id])
  cuentaId        Int
  tipo            TipoMovimientoCaja
  concepto        ConceptoMovimientoCaja
  monto           Float
  saldoResultante Float
  detalle         String?
  fecha           DateTime               @default(now())

  venta    Venta?  @relation(fields: [ventaId], references: [id])
  ventaId  Int?
  gasto    Gasto?  @relation(fields: [gastoId], references: [id])
  gastoId  Int?
  compra   Compra? @relation(fields: [compraId], references: [id])
  compraId Int?

  empresa   Empresa @relation(fields: [empresaId], references: [id])
  empresaId Int

  @@index([cuentaId])
  @@index([fecha])
  @@index([empresaId])
}

model CategoriaGasto {
  id     Int @id @default(autoincrement())
  nombre String
  gastos Gasto[]

  empresa   Empresa @relation(fields: [empresaId], references: [id])
  empresaId Int

  @@unique([empresaId, nombre])
  @@index([empresaId])
}

enum EstadoPagoGasto {
  PENDIENTE
  PAGADO
}

model Gasto {
  id            Int @id @default(autoincrement())
  monto         Float
  concepto      String
  categoria     CategoriaGasto? @relation(fields: [categoriaId], references: [id])
  categoriaId   Int?
  proveedor     Proveedor?      @relation(fields: [proveedorId], references: [id])
  proveedorId   Int?
  observaciones String?
  estadoPago    EstadoPagoGasto @default(PENDIENTE)
  fecha         DateTime        @default(now())

  movimientosCaja MovimientoCaja[]

  empresa   Empresa @relation(fields: [empresaId], references: [id])
  empresaId Int

  @@index([fecha])
  @@index([categoriaId])
  @@index([empresaId])
}

enum Licencia {
  BASICO
  PREMIUM
}

model Configuracion {
  id              Int     @id @default(autoincrement())
  nombreNegocio   String
  logoUrl         String?
  telefono        String?
  email           String?
  direccion       String?
  instagram       String?
  eslogan         String?
  remitenteNombre String?
  remitenteDni    String?

  // Colores de marca usados en los PDFs (catálogo, comprobantes, reportes).
  // Si no se cargan, se usa un valor neutro por defecto.
  colorPrimario   String? @default("#4F46E5")
  colorSecundario String? @default("#0891B2")

  // Licencia del template: define el paquete de módulos habilitados
  // (ver lib/configuracion.ts, obtenerConfiguracion() deriva los flags
  // usaCotizacionUSD/habilitarPresupuestos/habilitarReportesAvanzados/
  // habilitarGastosFlujoCaja a partir de este campo). Se carga a mano al
  // dar de alta cada empresa (scripts/crear-empresa.ts), no hay UI para
  // que el cliente final la cambie.
  licencia Licencia @default(BASICO)

  // Si el negocio no maneja precios en USD, este flag queda apagado y
  // el campo de cotización no se pide en Configuración (queda en su
  // valor por defecto, sin usarse para conversiones). Solo tiene efecto
  // si la licencia es PREMIUM — con licencia BASICO, usaCotizacionUSD
  // queda forzado a false sin importar este valor (ver lib/configuracion.ts).
  usaCotizacionUSD Boolean @default(false)
  cotizacionUSD    Float   @default(1000)
  // Hora (Argentina, "HH:MM") a la que la caja se abre sola cada día.
  horaAperturaCaja String  @default("07:00")

  // Compras
  costoPromedioPonderado Boolean @default(true)

  // Productos
  margenGananciaGlobal   Boolean @default(false)
  margenMinoristaDefault Float?
  margenMayoristaDefault Float?

  // Una Configuracion por Empresa (antes era una fila "singleton" global
  // para todo el sistema).
  empresa   Empresa @relation(fields: [empresaId], references: [id])
  empresaId Int     @unique

  updatedAt DateTime @updatedAt
}

// Cierre de caja (Básico y Premium). Cada cierre cubre los movimientos desde
// el cierre anterior no anulado. Lógica en app/(dashboard)/finanzas/cierre-caja/actions.ts.
model CierreCaja {
  id            Int      @id @default(autoincrement())
  fecha         DateTime @default(now())
  // Quién cerró. Sin relación a Usuario a propósito: si se borra al
  // empleado, el historial de cierres queda intacto.
  usuarioId     Int?
  usuarioNombre String
  observacion   String?
  // Último MovimientoCaja que cubre este cierre (incluye sus ajustes). El
  // próximo cierre toma los movimientos con id mayor. Más confiable que
  // comparar fechas.
  ultimoMovimientoId Int @default(0)

  anulado          Boolean   @default(false)
  anuladoFecha     DateTime?
  anuladoPorNombre String?

  // Turno que cierra (null en los cierres de antes de la apertura de caja).
  sesion   SesionCaja? @relation(fields: [sesionId], references: [id])
  sesionId Int?        @unique

  empresa   Empresa @relation(fields: [empresaId], references: [id])
  empresaId Int

  cuentas CierreCajaCuenta[]

  @@index([empresaId, fecha])
}

model CierreCajaCuenta {
  id       Int        @id @default(autoincrement())
  cierre   CierreCaja @relation(fields: [cierreId], references: [id], onDelete: Cascade)
  cierreId Int
  cuenta   Cuenta     @relation(fields: [cuentaId], references: [id])
  cuentaId Int

  // Todo en la moneda de la cuenta.
  saldoInicio Float  // saldo al cierre anterior (o al abrir la cuenta)
  ingresos    Float
  egresos     Float
  esperado    Float  // saldo del sistema al momento de cerrar
  // Efectivo: lo contado. Banco / billetera: el saldo que muestra la app.
  // null = no se revisó.
  contado     Float?
  diferencia  Float? // contado - esperado
  // Si la diferencia se corrigió con un AJUSTE_SALDO. El efectivo se ajusta
  // siempre; bancos y billeteras solo si el admin lo tilda (muchas veces la
  // diferencia es una transferencia que todavía no se acreditó).
  ajustado    Boolean @default(false)

  // Solo efectivo: cuánto quedó en la caja para el turno siguiente y cuánto
  // se retiró. El destino es "Retiro del dueño" o una cuenta (transferencia).
  queda           Float?
  retiro          Float?
  destinoCuentaId Int?    // null = retiro del dueño
  destinoNombre   String?

  @@index([cierreId])
}

// Turno de caja: se abre (sola a la hora configurada, o a mano) y se cierra
// con un CierreCaja. Los movimientos del turno son los de id mayor a
// aperturaMovimientoId. Lógica en src/lib/caja.ts.
model SesionCaja {
  id                   Int       @id @default(autoincrement())
  abiertaFecha         DateTime  @default(now())
  abiertaPorNombre     String
  aperturaAutomatica   Boolean   @default(false)
  aperturaMovimientoId Int       @default(0)
  cerradaFecha         DateTime?

  empresa   Empresa @relation(fields: [empresaId], references: [id])
  empresaId Int

  cierre CierreCaja?

  @@index([empresaId, cerradaFecha])
}
